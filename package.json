{
  "name": "turnfestanmeldungs-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint src tests tooling *.mjs",
    "format": "prettier --write src tests tooling docs *.md *.json *.ts *.mjs .github",
    "format:check": "prettier --check src tests tooling docs *.md *.json *.ts *.mjs .github",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "eslint": "^9.37.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0"
  },
  "license": "MIT"
}
